digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.1, bgcolor="white", fontname="DejaVu Sans", label="ER-диаграмма ИС «КодСтарт» (нотация Crow's Foot)", labelloc=t, fontsize=18];
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=10, color="#334155"];
users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#94A3B8"><tr><td colspan="3" bgcolor="#0F766E"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="id"><b>PK</b></td><td align="left" port="id_">id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="login"><b>UQ</b></td><td align="left" port="login_">login</td><td align="left"><font color="#64748B">VARCHAR(50)</font></td></tr><tr><td align="left" port="password_hash">  </td><td align="left" port="password_hash_">password_hash</td><td align="left"><font color="#64748B">VARCHAR(255)</font></td></tr><tr><td align="left" port="full_name">  </td><td align="left" port="full_name_">full_name</td><td align="left"><font color="#64748B">VARCHAR(150)</font></td></tr><tr><td align="left" port="phone">  </td><td align="left" port="phone_">phone</td><td align="left"><font color="#64748B">VARCHAR(20)</font></td></tr><tr><td align="left" port="email"><b>UQ</b></td><td align="left" port="email_">email</td><td align="left"><font color="#64748B">VARCHAR(100)</font></td></tr><tr><td align="left" port="role">  </td><td align="left" port="role_">role</td><td align="left"><font color="#64748B">ENUM</font></td></tr><tr><td align="left" port="created_at">  </td><td align="left" port="created_at_">created_at</td><td align="left"><font color="#64748B">DATETIME</font></td></tr></table>>];
courses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#94A3B8"><tr><td colspan="3" bgcolor="#0F766E"><font color="white"><b>courses</b></font></td></tr><tr><td align="left" port="id"><b>PK</b></td><td align="left" port="id_">id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="title">  </td><td align="left" port="title_">title</td><td align="left"><font color="#64748B">VARCHAR(100)</font></td></tr><tr><td align="left" port="description">  </td><td align="left" port="description_">description</td><td align="left"><font color="#64748B">TEXT</font></td></tr><tr><td align="left" port="duration_weeks">  </td><td align="left" port="duration_weeks_">duration_weeks</td><td align="left"><font color="#64748B">TINYINT</font></td></tr><tr><td align="left" port="price">  </td><td align="left" port="price_">price</td><td align="left"><font color="#64748B">DECIMAL(10,2)</font></td></tr></table>>];
statuses [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#94A3B8"><tr><td colspan="3" bgcolor="#0F766E"><font color="white"><b>statuses</b></font></td></tr><tr><td align="left" port="id"><b>PK</b></td><td align="left" port="id_">id</td><td align="left"><font color="#64748B">TINYINT</font></td></tr><tr><td align="left" port="name"><b>UQ</b></td><td align="left" port="name_">name</td><td align="left"><font color="#64748B">VARCHAR(50)</font></td></tr></table>>];
applications [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#94A3B8"><tr><td colspan="3" bgcolor="#B45309"><font color="white"><b>applications</b></font></td></tr><tr><td align="left" port="id"><b>PK</b></td><td align="left" port="id_">id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="user_id"><b>FK</b></td><td align="left" port="user_id_">user_id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="course_id"><b>FK</b></td><td align="left" port="course_id_">course_id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="start_date">  </td><td align="left" port="start_date_">start_date</td><td align="left"><font color="#64748B">DATE</font></td></tr><tr><td align="left" port="payment_method">  </td><td align="left" port="payment_method_">payment_method</td><td align="left"><font color="#64748B">ENUM</font></td></tr><tr><td align="left" port="comment">  </td><td align="left" port="comment_">comment</td><td align="left"><font color="#64748B">VARCHAR(255)</font></td></tr><tr><td align="left" port="status_id"><b>FK</b></td><td align="left" port="status_id_">status_id</td><td align="left"><font color="#64748B">TINYINT</font></td></tr><tr><td align="left" port="created_at">  </td><td align="left" port="created_at_">created_at</td><td align="left"><font color="#64748B">DATETIME</font></td></tr><tr><td align="left" port="updated_at">  </td><td align="left" port="updated_at_">updated_at</td><td align="left"><font color="#64748B">DATETIME</font></td></tr></table>>];
status_history [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="5" color="#94A3B8"><tr><td colspan="3" bgcolor="#475569"><font color="white"><b>status_history</b></font></td></tr><tr><td align="left" port="id"><b>PK</b></td><td align="left" port="id_">id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="application_id"><b>FK</b></td><td align="left" port="application_id_">application_id</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="status_id"><b>FK</b></td><td align="left" port="status_id_">status_id</td><td align="left"><font color="#64748B">TINYINT</font></td></tr><tr><td align="left" port="changed_by"><b>FK</b></td><td align="left" port="changed_by_">changed_by</td><td align="left"><font color="#64748B">INT</font></td></tr><tr><td align="left" port="changed_at">  </td><td align="left" port="changed_at_">changed_at</td><td align="left"><font color="#64748B">DATETIME</font></td></tr></table>>];
users -> applications [arrowhead=crowodot, arrowtail=teetee, dir=both, xlabel="user_id", fontcolor="#475569"];
courses -> applications [arrowhead=crowodot, arrowtail=teetee, dir=both, xlabel="course_id", fontcolor="#475569"];
statuses -> applications [arrowhead=crowodot, arrowtail=teetee, dir=both, xlabel="status_id", fontcolor="#475569"];
applications -> status_history [arrowhead=crowodot, arrowtail=teetee, dir=both, xlabel="application_id", fontcolor="#475569"];
statuses -> status_history [arrowhead=crowodot, arrowtail=teetee, dir=both, xlabel="status_id", fontcolor="#475569"];
users -> status_history [arrowhead=crowodot, arrowtail=teetee, dir=both, xlabel="changed_by", fontcolor="#475569"];
}